{
  "name": "campuskit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/audit-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:build": "node scripts/test-build-config.mjs",
    "test:browser-prepare": "npm run build && node scripts/prepare-browser-check.mjs",
    "verify:public": "node scripts/verify-public.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.4"
  }
}
